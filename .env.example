# Copy to .env and fill in.
# Pydantic AI's provider modules auto-read these by convention.
GOOGLE_API_KEY=your-key-here

# Optional — only needed if you want to use `make repl-claude` (lessons/13_clai_agent_repl/clai_anthropic.yaml)
# or any other Anthropic-backed agent.
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional — write token from https://logfire.pydantic.dev. With it set,
# intro Lesson 14 and temporal Lesson 09 ship traces to Logfire. Without
# it, Logfire instrumentation still runs (spans created locally) but the
# network exporter is a no-op.
# LOGFIRE_TOKEN=your-logfire-write-token
